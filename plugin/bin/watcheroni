#!/bin/sh
# Runs the watcheroni CLI for the Claude Code plugin. While the plugin is
# enabled this directory is on the Bash tool's PATH, so the skill can just
# say `watcheroni`. It looks for the real CLI in this order:
#
#   1. $WATCHERONI_CLI, a path to watcheroni.mjs
#   2. another `watcheroni` on PATH (npm install -g watcheroni)
#   3. this repository's build, packages/cli/dist/watcheroni.mjs, when the
#      plugin runs in place from a clone of the repository
#      (claude --plugin-dir plugin, after npm run build -w watcheroni).
#      An installed plugin runs from Claude Code's cache, without it.
#   4. npx --yes watcheroni@^X.Y.Z, the CLI version this plugin version
#      goes with, unless WATCHERONI_NO_NPX is set. With
#      WATCHERONI_NPX_OFFLINE set, only a copy npx already has in its cache
#      is used, so it never waits on the registry.
#
# Exits 127 if none of them is available.

# Kept equal to plugin.json's version (see RELEASING.md).
cli="watcheroni@^0.1.0"

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -n "$WATCHERONI_CLI" ]; then
  exec node "$WATCHERONI_CLI" "$@"
fi

old_ifs=$IFS
IFS=:
for dir in $PATH; do
  [ -n "$dir" ] || continue
  [ "$(CDPATH= cd -- "$dir" 2>/dev/null && pwd)" = "$here" ] && continue
  if [ -x "$dir/watcheroni" ]; then
    IFS=$old_ifs
    exec "$dir/watcheroni" "$@"
  fi
done
IFS=$old_ifs

build="$here/../../packages/cli/dist/watcheroni.mjs"
if [ -f "$build" ]; then
  exec node "$build" "$@"
fi

if [ -z "$WATCHERONI_NO_NPX" ] && command -v npx >/dev/null 2>&1; then
  if [ -n "$WATCHERONI_NPX_OFFLINE" ]; then
    exec npx --offline --yes "$cli" "$@"
  fi
  exec npx --yes "$cli" "$@"
fi

echo "watcheroni: the CLI isn't installed. Run \`npm install -g $cli\`, or build it from a clone with \`npm run build -w watcheroni\` and set WATCHERONI_CLI to packages/cli/dist/watcheroni.mjs." >&2
exit 127
