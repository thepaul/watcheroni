{
  "name": "watcheroni",
  "version": "0.0.0",
  "description": "Wait for, stream, or act on what happens to GitHub pull requests",
  "license": "MIT",
  "type": "module",
  "bin": {
    "watcheroni": "dist/watcheroni.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/watcheroni.mjs --banner:js='#!/usr/bin/env node'",
    "dev": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@watcheroni/protocol": "0.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
