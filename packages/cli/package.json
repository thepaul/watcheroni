{
  "name": "watcheroni",
  "version": "0.1.0",
  "description": "Wait for, stream, or act on what happens to GitHub pull requests",
  "license": "MIT",
  "author": "paul cannon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thepaul/watcheroni.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/thepaul/watcheroni/tree/main/packages/cli#readme",
  "bugs": "https://github.com/thepaul/watcheroni/issues",
  "keywords": [
    "github",
    "pull-request",
    "pr",
    "ci",
    "webhooks",
    "notifications",
    "cli",
    "claude-code"
  ],
  "type": "module",
  "bin": {
    "watcheroni": "dist/watcheroni.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/watcheroni.mjs --banner:js='#!/usr/bin/env node'",
    "dev": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@watcheroni/protocol": "*",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
