{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "watcheroni-proto",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-20",
  // request.signal lets the long-poll bridge notice a client hanging up.
  "compatibility_flags": ["enable_request_signal"],
  "observability": { "enabled": true },
  // The logo and favicons (src/images.ts): SVGs as strings, the rest as
  // ArrayBuffers.
  "rules": [
    { "type": "Text", "globs": ["**/*.svg"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.png", "**/*.ico"], "fallthrough": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT", "class_name": "Account" },
      { "name": "REPO_HUB", "class_name": "RepoHub" },
      { "name": "INSTALLATION", "class_name": "Installation" },
      { "name": "CONTROL", "class_name": "Control" }
    ]
  },
  // Per-IP limits on the sign-in endpoints, which need no API key and each
  // cost a GitHub call made with the App's client secret ("Per IP address"
  // in DESIGN.md). Namespace IDs are per Cloudflare account, so the test
  // server and production use different ones.
  "ratelimits": [
    { "name": "LOGIN_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "REFRESH_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  // The redelivery cron runs on production only: both Workers use the same
  // GitHub App, whose webhooks go to production, so a second cron on the
  // test server would only redeliver the same failures twice. On the test
  // server, POST /debug/control/redeliver runs it by hand.
  "triggers": { "crons": [] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Account"] },
    { "tag": "v2", "new_sqlite_classes": ["RepoHub"] },
    { "tag": "v3", "new_sqlite_classes": ["Installation"] },
    { "tag": "v4", "new_sqlite_classes": ["Control"] }
  ],
  "vars": {
    "GITHUB_APP_ID": "5490181",
    // The GitHub App's client ID (public). Empty until the App is
    // registered; sign-in answers 503 until then.
    "GITHUB_CLIENT_ID": "Iv23li1qpgDkOHqZsdtt",
    // The App's URL name, for its install page
    // (https://github.com/apps/<slug>/installations/new).
    "GITHUB_APP_SLUG": "watcheroni"
  },
  // Secrets, not in this file (wrangler secret put, or .dev.vars for
  // wrangler dev): GITHUB_APP_PRIVATE_KEY (PKCS#8 PEM), GITHUB_CLIENT_SECRET,
  // GITHUB_WEBHOOK_SECRET, TICKET_KEY, API_KEY_SECRET (the HMAC key for
  // the tag on API keys; changing it invalidates every key), STORAGE_KEY
  // (32 bytes of base64, for the cached installation tokens), and during
  // rotation TICKET_KEY_OLD. DEBUG_TOKEN turns on the /debug routes; leave
  // it unset in production.

  // The top level is the test server, watcheroni-proto on workers.dev, so
  // a plain `wrangler deploy` can't touch production. Production is
  // `--env production`: its own Worker, so its own Durable Objects and
  // secrets, at https://watcheroni.dev. Bindings and vars aren't inherited
  // by environments, hence the repetition.
  "env": {
    "production": {
      "name": "watcheroni",
      "workers_dev": false,
      "routes": [{ "pattern": "watcheroni.dev", "custom_domain": true }],
      "durable_objects": {
        "bindings": [
          { "name": "ACCOUNT", "class_name": "Account" },
          { "name": "REPO_HUB", "class_name": "RepoHub" },
          { "name": "INSTALLATION", "class_name": "Installation" },
          { "name": "CONTROL", "class_name": "Control" }
        ]
      },
      "ratelimits": [
        { "name": "LOGIN_RATE_LIMIT", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "REFRESH_RATE_LIMIT", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } }
      ],
      // Every 10 minutes: Control redelivers webhooks that failed.
      "triggers": { "crons": ["*/10 * * * *"] },
      "vars": {
        "GITHUB_APP_ID": "5490181",
        "GITHUB_CLIENT_ID": "Iv23li1qpgDkOHqZsdtt",
        "GITHUB_APP_SLUG": "watcheroni"
      }
    }
  }
}
