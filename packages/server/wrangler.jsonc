{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "watcheroni-proto",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-20",
  // request.signal lets the long-poll bridge notice a client hanging up.
  "compatibility_flags": ["enable_request_signal"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT", "class_name": "Account" },
      { "name": "REPO_HUB", "class_name": "RepoHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Account"] },
    { "tag": "v2", "new_sqlite_classes": ["RepoHub"] }
  ],
  "vars": {
    "GITHUB_APP_ID": "5490181",
    // The GitHub App's client ID (public). Empty until the App is
    // registered; sign-in answers 503 until then.
    "GITHUB_CLIENT_ID": "Iv23li1qpgDkOHqZsdtt"
  }
  // Secrets, not in this file (wrangler secret put, or .dev.vars for
  // wrangler dev): GITHUB_CLIENT_SECRET, GITHUB_WEBHOOK_SECRET, TICKET_KEY,
  // and during rotation TICKET_KEY_OLD. DEBUG_TOKEN turns on the /debug
  // routes; leave it unset in production.
}
