GITHUB_CLIENT_SECRET=change-me
GITHUB_WEBHOOK_SECRET=change-me
# HMAC key for WebSocket tickets, e.g. `openssl rand -base64 32`.
TICKET_KEY=change-me
# The previous TICKET_KEY while rotating; tickets live 60 seconds, so it
# can be removed a minute after the new key is in place.
TICKET_KEY_OLD=
# HMAC key for the tag on API keys, e.g. `openssl rand -base64 32`.
# Changing it invalidates every wk2 key issued under the old one.
API_KEY_SECRET=change-me
# Turns on the /debug routes (minting keys, injecting events, stats).
DEBUG_TOKEN=change-me
# The App's private key as PKCS#8 PEM (GitHub gives PKCS#1; convert with
# `openssl pkcs8 -topk8 -nocrypt -in key.pem`).
GITHUB_APP_PRIVATE_KEY=change-me
# AES-256-GCM key for cached installation tokens: `openssl rand -base64 32`.
STORAGE_KEY=change-me
